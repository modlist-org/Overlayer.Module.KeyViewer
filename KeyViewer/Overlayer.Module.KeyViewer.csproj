<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>netstandard2.1</TargetFramework>
        <Nullable>enable</Nullable>
        <LangVersion>default</LangVersion>
        <NeutralLanguage>en-US</NeutralLanguage>
        <AssemblyName>Overlayer.Module.KeyViewer</AssemblyName>
        <LangVersion>latest</LangVersion>
        <OverlayerPath Condition="'$(OverlayerPath)' == ''">../../Overlayer/Overlayer</OverlayerPath>
    </PropertyGroup>

    <PropertyGroup>
        <!-- O5Kit (UI + input toolkit). Module is Mono-only: Debug/Release map to O5Kit *_Mono. -->
        <O5KitProject>$(MSBuildProjectDirectory)/../../O5Kit/src/O5Kit/O5Kit.csproj</O5KitProject>
        <O5KitConfiguration Condition="$(Configuration.Contains('Debug'))">Debug_Mono</O5KitConfiguration>
        <O5KitConfiguration Condition="!$(Configuration.Contains('Debug'))">Release_Mono</O5KitConfiguration>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="$(O5KitProject)">
            <SetConfiguration>Configuration=$(O5KitConfiguration)</SetConfiguration>
            <SetTargetFramework>TargetFramework=netstandard2.1</SetTargetFramework>
        </ProjectReference>
    </ItemGroup>

    <PropertyGroup>
        <NativeFileDialogVersion>1.2.0</NativeFileDialogVersion>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="NativeFileDialog.Extended" Version="$(NativeFileDialogVersion)" />
    </ItemGroup>

    <ItemGroup>
        <Reference Include="Overlayer" HintPath="$(OverlayerPath)/bin/Release_ML/netstandard2.1/Overlayer.dll" />
        <Reference Include="0Harmony" HintPath="$(GamePath)/MelonLoader/net35/0Harmony.dll" />
        <Reference Include="Newtonsoft.Json" HintPath="$(GamePath)/$(GameData)/Managed/Newtonsoft.Json.dll" />
        <Reference Include="Unity.TextMeshPro" HintPath="$(GamePath)/$(GameData)/Managed/Unity.TextMeshPro.dll" />
        <Reference Include="UnityEngine" HintPath="$(GamePath)/$(GameData)/Managed/UnityEngine.dll" />
        <Reference Include="UnityEngine.CoreModule" HintPath="$(GamePath)/$(GameData)/Managed/UnityEngine.CoreModule.dll" />
        <Reference Include="UnityEngine.ImageConversionModule" HintPath="$(GamePath)/$(GameData)/Managed/UnityEngine.ImageConversionModule.dll" />
        <Reference Include="UnityEngine.IMGUIModule" HintPath="$(GamePath)/$(GameData)/Managed/UnityEngine.IMGUIModule.dll" />
        <Reference Include="UnityEngine.InputLegacyModule" HintPath="$(GamePath)/$(GameData)/Managed/UnityEngine.InputLegacyModule.dll" />
        <Reference Include="UnityEngine.TextRenderingModule" HintPath="$(GamePath)/$(GameData)/Managed/UnityEngine.TextRenderingModule.dll" />
        <Reference Include="UnityEngine.UI" HintPath="$(GamePath)/$(GameData)/Managed/UnityEngine.UI.dll" />
        <Reference Include="UnityEngine.UIModule" HintPath="$(GamePath)/$(GameData)/Managed/UnityEngine.UIModule.dll" />
    </ItemGroup>

    <Target Name="PostBuild" AfterTargets="Build" Condition="'$(SkipPostBuild)' != 'true'">
        <MakeDir Directories="$(GamePath)/UserLibs" Condition="'$(TargetPath)' != ''" />
        <Copy Condition="'$(TargetPath)' != ''" SourceFiles="$(TargetPath)" DestinationFolder="$(GamePath)/UserLibs" SkipUnchangedFiles="true" />
        <Copy SourceFiles="$(TargetDir)O5Kit.dll" DestinationFolder="$(GamePath)/UserLibs" SkipUnchangedFiles="true" Condition="Exists('$(TargetDir)O5Kit.dll')" />

        <ItemGroup>
            <ExportFiles Include="Resource/Export/**/*.*" />
        </ItemGroup>

        <MakeDir Directories="$(GamePath)/UserData/Overlayer/Module/KeyViewer/" />
        <Copy SourceFiles="@(ExportFiles)" DestinationFiles="@(ExportFiles->'$(GamePath)/UserData/Overlayer/Module/KeyViewer/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />

        <PropertyGroup>
            <SolutionRoot Condition="'$(SolutionDir)' != '' And '$(SolutionDir)' != '*Undefined*'">$(SolutionDir)</SolutionRoot>
            <SolutionRoot Condition="'$(SolutionDir)' == '' Or '$(SolutionDir)' == '*Undefined*'">$(MSBuildProjectDirectory)\..\</SolutionRoot>
            <BuildOutputDir>$(SolutionRoot)\.build\$(Configuration)\$(TargetName)</BuildOutputDir>
        </PropertyGroup>
        <MakeDir Directories="$(BuildOutputDir)\UserLibs" Condition="'$(TargetPath)' != ''" />
        <Copy Condition="'$(TargetPath)' != ''" SourceFiles="$(TargetPath)" DestinationFolder="$(BuildOutputDir)\UserLibs" SkipUnchangedFiles="true" />
        <Copy SourceFiles="$(TargetDir)O5Kit.dll" DestinationFolder="$(BuildOutputDir)\UserLibs" SkipUnchangedFiles="true" Condition="Exists('$(TargetDir)O5Kit.dll')" />
        <MakeDir Directories="$(BuildOutputDir)\UserData\Overlayer\Module\KeyViewer" />
        <Copy SourceFiles="@(ExportFiles)" DestinationFiles="@(ExportFiles->'$(BuildOutputDir)\UserData\Overlayer\Module\KeyViewer\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    </Target>
</Project>
